# Copy to .env for local development against `docker compose up`.
# File upload config, read by @defra/forms-engine-plugin.

# cdp-uploader base URL
UPLOADER_URL=http://localhost:7337

# S3 bucket the cdp-uploader delivers scanned files to
UPLOADER_BUCKET_NAME=apha-sdo-uploads

# key prefix within the bucket
STAGING_PREFIX=staging

# base URL for the scan-completion callback ({SUBMISSION_URL}/file);
# must be reachable from the cdp-uploader container
SUBMISSION_URL=http://host.docker.internal:3000

# --- Azure Blob Storage transfer (submissions) ---

# enable transfer of submitted files + answers to Azure Blob Storage
AZURE_STORAGE_ENABLED=true

# Azurite emulator with the well-known dev credentials (docker compose `azurite` service);
# in deployed environments use a real connection string or the AZURE_* credential vars
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;

# Azure Blob container that receives submissions
AZURE_CONTAINER_NAME=apha-sdo-submissions

# --- S3 staging bucket access (scanned files are downloaded at submit) ---

# localstack S3 endpoint; leave unset in deployed environments (real S3 + IAM)
S3_ENDPOINT=http://localhost:4566
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- Internal user authentication (Microsoft Entra ID) ---

# Offline local mode. Start with `npm run auth:stub` or `npm run docker:up`.
AUTH_ENTRA_ID_CREDENTIAL_MODE=mock
AUTH_ENTRA_ID_OIDC_CONFIGURATION_URL=http://localhost:5556/.well-known/openid-configuration
AUTH_ENTRA_ID_CLIENT_ID=local-stub-client
AUTH_ENTRA_ID_AUTHORIZATION_MODE=groups
AUTH_ENTRA_ID_ALLOWED_GROUP_IDS=local-dev-group
APP_BASE_URL=http://localhost:3000

# Entra app roles the stub user signs in with (Lab.<LAB>.<BR|AHR>). Read by the
# stub, not the app. Defaults to both journeys; uncomment for the BR-only view.
# OIDC_STUB_ROLES=Lab.LocalLab.BR

# --- External (laboratory) user authentication (Defra Customer Identity) ---

# Local development runs against the cdp-defra-id-stub container started by
# `npm run docker:up`, which also seeds the test identities (re-seed with
# `npm run defra-id:register`). Deployed environments use the real Customer
# Identity values from onboarding instead; see README "External sign-in".
AUTH_DEFRA_ID_ENABLED=true
AUTH_DEFRA_ID_OIDC_CONFIGURATION_URL=http://localhost:3200/cdp-defra-id-stub/.well-known/openid-configuration
AUTH_DEFRA_ID_CLIENT_ID=local-defra-id-client
AUTH_DEFRA_ID_CLIENT_SECRET=test_value
# Issued at onboarding; the stub ignores it. Against Customer Identity the
# scopes must also include the client ID so an access token is issued.
AUTH_DEFRA_ID_SERVICE_ID=
AUTH_DEFRA_ID_SCOPES=openid offline_access
# Your Defra account, linked from the service for laboratory users
AUTH_DEFRA_ID_ACCOUNT_MANAGEMENT_URL=http://localhost:3200/cdp-defra-id-stub
# Customer Identity service role names granting each journey; defaults match
# the roles GIO configured ("Default" is the placeholder with no journey).
# AUTH_DEFRA_ID_ROLE_BR=BR
# AUTH_DEFRA_ID_ROLE_AHR=AHR

# Use a unique value of at least 32 characters outside local development.
SESSION_COOKIE_PASSWORD=local-cookie-password-change-before-deploying
