{
  "name": "apha-sdo-system",
  "version": "0.0.0",
  "description": "CDP Frontend Template",
  "sideEffects": false,
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:frontend": "vite build",
    "auth:stub": "node scripts/oidc-stub.js",
    "dev": "cross-env AWS_EMF_ENVIRONMENT=Local npm run server:watch",
    "dev:debug": "cross-env AWS_EMF_ENVIRONMENT=Local npm run server:debug",
    "docker:dev": "npm run dev",
    "docker:up": "docker compose up --detach --wait --quiet-pull proxy localstack redis cdp-uploader azurite oidc-stub && docker compose ps",
    "docker:logs": "docker compose logs --follow",
    "docker:down": "docker compose down",
    "storage:check": "node --env-file-if-exists=.env scripts/storage.js",
    "storage:clean": "node --env-file-if-exists=.env scripts/storage.js clean",
    "format": "prettier --write \"src/**/*.js\" \"**/*.{js,cjs,md,json,config.js,test.js}\"",
    "format:check": "prettier --check \"src/**/*.js\" \"**/*.{js,cjs,md,json,config.js,test.js}\"",
    "git:pre-commit-hook": "npm run security-audit && npm run format:check && npm run lint && npm test",
    "lint": "run-s lint:js lint:scss",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:scss": "stylelint \"src/**/*.scss\" --cache --cache-location .cache/stylelint --cache-strategy content --color --ignore-path .gitignore",
    "test": "cross-env AWS_EMF_ENVIRONMENT=Local TZ=UTC vitest run --coverage",
    "test:watch": "cross-env AWS_EMF_ENVIRONMENT=Local TZ=UTC vitest",
    "security-audit": "npm audit --audit-level=critical",
    "server:watch": "nodemon --inspect=0.0.0.0 --ext js,json --legacy-watch --watch ./src/server --watch ./src/config --env-file-if-exists=.env ./src",
    "server:debug": "nodemon --inspect-brk=0.0.0.0 --ext js,json --legacy-watch --watch ./src/server --watch ./src/config --env-file-if-exists=.env ./src",
    "prestart": "npm run build:frontend",
    "start": "NODE_ENV=production node .",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module"
  },
  "imports": {
    "#/*": "./src/*",
    "#/test-helpers/*": "./test-helpers/*"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1111.0",
    "@aws-sdk/client-sts": "3.1111.0",
    "@azure/identity": "4.13.1",
    "@azure/storage-blob": "12.33.0",
    "@defra/cdp-auditing": "0.6.1",
    "@defra/cdp-metrics": "0.6.0",
    "@defra/forms-engine-plugin": "5.0.0-alpha.16",
    "@defra/hapi-auth-oidc": "0.5.6",
    "@defra/hapi-secure-context": "0.4.0",
    "@defra/hapi-tracing": "1.30.0",
    "@elastic/ecs-pino-format": "1.5.0",
    "@hapi/boom": "10.0.1",
    "@hapi/catbox-memory": "6.0.2",
    "@hapi/catbox-redis": "7.0.2",
    "@hapi/cookie": "12.0.1",
    "@hapi/crumb": "9.0.1",
    "@hapi/hapi": "21.4.10",
    "@hapi/inert": "7.1.2",
    "@hapi/scooter": "8.0.0",
    "@hapi/vision": "7.0.3",
    "@hapi/yar": "11.0.3",
    "aws-sdk-v3-proxy": "2.2.0",
    "blankie": "5.0.0",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "cssnano": "8.0.6",
    "cssnano-preset-default": "8.0.6",
    "date-fns": "4.4.0",
    "govuk-frontend": "6.4.0",
    "hapi-pino": "13.0.0",
    "hapi-pulse": "4.0.0",
    "ioredis": "6.0.0",
    "lodash": "4.18.1",
    "nunjucks": "3.2.4",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@babel/preset-env": "7.29.2",
    "@vitest/coverage-v8": "4.1.8",
    "cheerio": "1.2.0",
    "cross-env": "10.1.0",
    "eslint": "9.39.2",
    "husky": "9.1.7",
    "neostandard": "0.13.0",
    "nodemon": "3.1.14",
    "npm-run-all": "4.1.5",
    "oauth2-mock-server": "9.1.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.8.2",
    "sass-embedded": "1.99.0",
    "stylelint": "16.26.1",
    "stylelint-config-gds": "2.0.0",
    "vite": "8.0.16",
    "vitest": "4.1.8",
    "vitest-fetch-mock": "0.4.5"
  }
}
