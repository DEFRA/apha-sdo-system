{% extends 'layouts/page.njk' %}

{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      {% if error %}
        {% set errorMessage = { text: error } %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: [
            {
              text: error,
              href: "#submissionAction"
            }
          ]
        }) }}
      {% endif %}

      {% if not hasReportTypes %}
        {# Laboratory users get their report types from their own lab's account
           administrator in Your Defra account; internal users from APHA. #}
        {% if signedInUser.provider == "defraId" %}
          {% set noReportTypesHtml %}
            Your account is not set up for any report type yet. Ask your laboratory's account administrator to give you access to Bat rabies or Animal Health Regulations reporting in
            {% if accountManagementUrl %}<a href="{{ accountManagementUrl }}" class="govuk-link">Your Defra account</a>{% else %}Your Defra account{% endif %}.
            If you are the administrator, you can do this yourself.
          {% endset %}
          {{ govukInsetText({
            html: noReportTypesHtml
          }) }}
        {% else %}
          {{ govukInsetText({
            text: "Your account is not assigned to any report type. Ask your APHA administrator to request access."
          }) }}
        {% endif %}
      {% endif %}

      {# A lab's first step: Animal Health Regulations is not offered until
         its diagnostic tests are defined #}
      {% if awaitingDiagnosticTests %}
        {% set diagnosticTestsBannerHtml %}
          <p class="govuk-notification-banner__heading">You need to set up your diagnostic tests before you can submit an Animal Health Regulations report.</p>
          <p class="govuk-body">Select ‘Update your diagnostic tests in use’ to tell us which qualifying tests your laboratory uses and their UKAS accreditation.</p>
        {% endset %}
        {{ govukNotificationBanner({
          html: diagnosticTestsBannerHtml
        }) }}
      {% endif %}

      <form method="post" action="/submission-welcome" novalidate>
        <input type="hidden" name="crumb" value="{{ crumb }}">
        {{ govukRadios({
          name: "submissionAction",
          fieldset: {
            legend: {
              text: heading,
              isPageHeading: true,
              classes: "govuk-fieldset__legend--l"
            }
          },
          items: submissionActionItems,
          errorMessage: errorMessage
        }) }}
        {{ govukButton({
          type: "submit",
          text: "Continue"
        }) }}
      </form>
    </div>
  </div>
{% endblock %}
