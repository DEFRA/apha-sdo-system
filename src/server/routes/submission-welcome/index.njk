{% extends 'layouts/page.njk' %}

{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      {% if error %}
        {% set errorMessage = { text: error } %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: [
            {
              text: error,
              href: "#submissionAction"
            }
          ]
        }) }}
      {% endif %}

      {% if not hasReportTypes %}
        {{ govukInsetText({
          text: "Your account is not assigned to any report type. Ask your APHA administrator to request access."
        }) }}
      {% endif %}

      <form method="post" action="/submission-welcome" novalidate>
        <input type="hidden" name="crumb" value="{{ crumb }}">
        {{ govukRadios({
          name: "submissionAction",
          fieldset: {
            legend: {
              text: heading,
              isPageHeading: true,
              classes: "govuk-fieldset__legend--l"
            }
          },
          items: submissionActionItems,
          errorMessage: errorMessage
        }) }}
        {{ govukButton({
          type: "submit",
          text: "Continue"
        }) }}
      </form>
    </div>
  </div>
{% endblock %}
