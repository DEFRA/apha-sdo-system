{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}

{% block content %}
  <h1 class="govuk-heading-l">{{ pageTitle }}</h1>

  {% if reportType %}
    <p class="govuk-body">
      Your account is not assigned to <strong>{{ reportType }}</strong>
      submissions.
    </p>
    {# Laboratory users get their report types from their own lab's account
       administrator in Your Defra account; internal users from APHA. #}
    {% if signedInUser.provider == "defraId" %}
      <p class="govuk-body">
        Ask your laboratory's account administrator to give you access to this report type in
        {% if accountManagementUrl %}<a href="{{ accountManagementUrl }}" class="govuk-link">Your Defra account</a>{% else %}Your Defra account{% endif %}.
        If you are the administrator, you can do this yourself. Or
        <a href="/submission-welcome" class="govuk-link">go back to the report types you can submit</a>.
      </p>
    {% else %}
      <p class="govuk-body">
        Ask your APHA administrator to request access to this report type, or
        <a href="/submission-welcome" class="govuk-link">go back to the report types you can submit</a>.
      </p>
    {% endif %}
  {% else %}
    {% if account %}
      <p class="govuk-body">
        You signed in as <strong>{{ account }}</strong>, which is not a member of
        a group that can use this service.
      </p>
    {% else %}
      <p class="govuk-body">
        The account you signed in with is not a member of a group that can use
        this service.
      </p>
    {% endif %}

    <p class="govuk-body">
      Ask your APHA administrator to request access for your account.
    </p>
  {% endif %}

  <h2 class="govuk-heading-m">If you have another account</h2>

  <p class="govuk-body">
    You are still signed in to Defra. Sign out first, then sign in with the
    account that has access.
  </p>

  {# Sign out is a form post so it cannot be triggered from another site #}
  <form method="post" action="/sign-out">
    <input type="hidden" name="crumb" value="{{ crumb }}">
    {{ govukButton({
      text: "Sign out of Defra"
    }) }}
  </form>
{% endblock %}
