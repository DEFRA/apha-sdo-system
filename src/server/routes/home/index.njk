{% extends 'layouts/page.njk' %}

{% block content %}
  {{ appHeading({
    text: serviceName,
    width: "three-quarters"
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-three-quarters">
      <div class="govuk-body" data-testid="app-page-body">
        <p class="govuk-body-l">
          Submit your veterinary surveillance data to APHA. You'll be helping with the detection and assessment of disease-related threats to livestock and wildlife in Great Britain.
        </p>

        <a href="/sign-in-choose" class="govuk-button govuk-button--start govuk-!-margin-top-4 govuk-!-margin-bottom-6" data-module="govuk-button">
          Continue
          <svg class="govuk-button__start-icon" xmlns="http://www.w3.org/2000/svg" width="17.5" height="19" viewBox="0 0 33 40" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="m0 0h13l20 20-20 20H0l20-20z"></path>
          </svg>
        </a>

        <div class="govuk-inset-text govuk-!-margin-top-7">
          <p>This system is for authorised APHA personnel and approved external partners involved in veterinary surveillance activities.</p>
        </div>

        <p>
          Check the guidance on <a href="https://www.gov.uk/government/publications/listed-diseases-in-animals-case-definitions-testing-and-reporting/reportable-diseases-monthly-reporting-requirements-for-diagnostic-laboratories" class="govuk-link">Reportable diseases: monthly reporting requirements for diagnostic laboratories</a>.
        </p>
      </div>
    </div>
  </div>

{% endblock %}
