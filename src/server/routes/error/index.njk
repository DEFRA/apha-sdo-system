{% extends 'layouts/page.njk' %}

{% block content %}
  {{ appHeading({
    text: heading
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <p>{{ message }}</p>
      {% if correlationId %}
        <p class="govuk-body-s">Reference: {{ correlationId }}</p>
      {% endif %}
    </div>
  </div>
{% endblock %}
